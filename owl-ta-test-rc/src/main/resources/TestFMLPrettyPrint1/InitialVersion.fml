use org.openflexo.technologyadapter.owl.OWLModelSlot as OWL;

import org.openflexo.technologyadapter.owl.model.OWLOntology;
import org.openflexo.technologyadapter.owl.model.OWLClass;

import OWLOntology ANIMALS from ["http://openflexo.org/test/animals"];
import OWLClass MOUSE from [ANIMALS:"Mouse"];

/** This is a test */
public model MyModel {
	OWLOntology ontology with OWLModelSlot(importedOntology=ANIMALS);

	foo() {	
		OWL::AddOWLIndividual(ontologyClass=MOUSE,individualName="myIndividual") in ontology;
	}
}
